# Run npm run setup:env to generate a local-only .env with a fresh secret.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:51214/template1?sslmode=disable
SHADOW_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:51215/template1?sslmode=disable
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=
# Registration currently requires this flag and a loopback auth URL.
# Set up email verification/recovery and revise the gate before a public launch.
AUTH_LOCAL_PILOT=true
# Hosted test pilot: set AUTH_LOCAL_PILOT=false and use the canonical HTTPS URL.
# These opt-ins do not enable verified-email production authentication or real billing.
AUTH_HOSTED_PILOT=false
HOSTED_MOCK_PAYMENTS=false
SPEAKING_LAB_ENABLED=false


# Server-only AI mathematics tutor; never use a NEXT_PUBLIC_ key variable.
DEEPSEEK_API_KEY=
# Optional model override. Default follows the verified DeepSeek API guide.
DEEPSEEK_MODEL=deepseek-flash

# Optional local transcription model for the IELTS Speaking Lab (default onnx-community/whisper-base.en).
# SPEAKING_WHISPER_MODEL=onnx-community/whisper-tiny.en

# Owner-enabled public/shared learner demos. Never grants admin rights.
AUTH_HOSTED_DEMO_ACCOUNTS=false
# Authentication mail (Resend HTTPS API); sender must be verified by the provider.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Development-only Gmail SMTP. Requires 2-Step Verification and a 16-character App Password.
# When set locally, Gmail takes precedence over Resend; never active on hosted/Vercel.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Hosted mail automatically requires verification; local QA can opt in explicitly.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Local-only ignored outbox for automated tests; takes precedence over Gmail/Resend and is impossible on a hosted origin.
AUTH_EMAIL_TEST_MODE=false
# Google Cloud Web OAuth client; callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
