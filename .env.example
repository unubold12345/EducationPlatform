# Run npm run setup:env to generate a local-only .env with a fresh secret.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:51214/template1?sslmode=disable
SHADOW_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:51215/template1?sslmode=disable
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=
# Registration currently requires this flag and a loopback auth URL.
# Set up email verification/recovery and revise the gate before a public launch.
AUTH_LOCAL_PILOT=true


# Server-only AI mathematics tutor; never use a NEXT_PUBLIC_ key variable.
DEEPSEEK_API_KEY=
# Optional model override. Default follows the verified DeepSeek API guide.
DEEPSEEK_MODEL=deepseek-flash

# Optional local transcription model for the IELTS Speaking Lab (default onnx-community/whisper-base.en).
# SPEAKING_WHISPER_MODEL=onnx-community/whisper-tiny.en
